# Shopify store domain (canonical Hydrogen name).
# Legacy fallback: SHOPIFY_STORE_DOMAIN
PUBLIC_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API token (optional; omit for tokenless / mock.shop).
# Do not set an empty value — leave commented until you have a token.
# Legacy fallback: SHOPIFY_PUBLIC_ACCESS_TOKEN
# PUBLIC_STOREFRONT_API_TOKEN=

# Private Storefront API token (server-only; prefer over public for SSR).
# Legacy fallback: SHOPIFY_PRIVATE_ACCESS_TOKEN
PRIVATE_STOREFRONT_API_TOKEN=

# Hydrogen storefront ID. Use "0" when unknown.
PUBLIC_STOREFRONT_ID=0

# Optional: app-level checkout domain for CSP (checkout URLs still come from cart.checkoutUrl).
# PUBLIC_CHECKOUT_DOMAIN=

# Shopify Admin API (newsletter — write_customers + write_customers_marketing_consent)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Legacy revalidation secret (still used by existing app webhook/revalidate routes).
SHOPIFY_REVALIDATION_SECRET=

# Newsletter confirm-token HMAC (do not reuse SHOPIFY_REVALIDATION_SECRET)
NEWSLETTER_CONFIRM_SECRET=

# Resend (double opt-in confirmation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public site origin for confirmation links (https, no trailing slash).
# Required in production so confirm emails never take Host / X-Forwarded-* from the request.
# On Vercel preview, omit this to use VERCEL_URL for the current deployment.
NEXT_PUBLIC_SITE_URL=

# Sentry (set by the Vercel Marketplace integration on preview/production)
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN fallback if NEXT_PUBLIC_SENTRY_DSN is unset
# SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source map upload during `next build`. Build still succeeds if this is unset.
SENTRY_AUTH_TOKEN=
